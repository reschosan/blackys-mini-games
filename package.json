{
  "name": "blackys-mini-games",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:host": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "test:e2e:reality": "REALITY=1 playwright test e2e/realityCheck --workers=1",
    "test:e2e:sweep": "SWEEP=1 playwright test e2e/screenSweep.spec.ts --workers=1",
    "test:e2e:layout": "playwright test --config playwright.layout.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,cjs}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\" \"*.{ts,js,cjs}\"",
    "deps": "depcruise src --config .dependency-cruiser.cjs",
    "unused": "knip",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deps && npm run unused && npm test",
    "manifest": "cem analyze && node scripts/generateWebTypes.mjs"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lil-gui": "^0.20.0",
    "lit": "^3.3.3",
    "qrcode": "^1.5.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.180.0",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "happy-dom": "^20.14.5",
    "knip": "^6.38.0",
    "prettier": "3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.1.5",
    "vitest": "^5.0.2"
  },
  "customElements": "custom-elements.json",
  "web-types": "web-types.json",
  "license": "MIT"
}
